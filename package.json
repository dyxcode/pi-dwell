{
  "name": "pi-dwell",
  "version": "0.0.0",
  "description": "A persistent home for Pi sessions and background work.",
  "private": true,
  "license": "MIT",
  "author": "dyxcode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyxcode/pi-dwell.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "docs/i18n/zh-CN/README.md",
    "docs/handbook",
    "docs/i18n/zh-CN/handbook"
  ],
  "scripts": {
    "start": "node src/cli.ts serve",
    "dev": "node --watch src/cli.ts serve --dev",
    "dwell": "node src/cli.ts",
    "lint": "biome lint --error-on-warnings",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:docs && npm test",
    "check:package": "node scripts/check-package.mjs",
    "check:pi": "node scripts/check-pi.ts",
    "check:web": "node scripts/check-web.ts",
    "check:docs": "node scripts/check-docs.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "marked": "18.0.11"
  }
}
